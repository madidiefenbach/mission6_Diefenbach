@using mission6.Models
@{
    ViewData["Title"] = "Delete Movie";
}
@model Movie

<div class="container mt-4">
    <h1>Delete Movie</h1>
    <p class="lead text-danger">Are you sure you want to delete this movie from the collection?</p>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Director</dt>
                <dd class="col-sm-9">@(Model.Director ?? "-")</dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">@(Model.Rating ?? "-")</dd>
            </dl>

            <form asp-action="Delete" asp-controller="Home" method="post">
                <input type="hidden" asp-for="MovieID" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-controller="Home" asp-action="ShowMovie" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
